# Firebase Web-Konfiguration (Firebase Console → Projekteinstellungen → Allgemein → Meine Apps → Web-App).
# Als .env.local kopieren und ausfüllen. Diese Werte sind öffentlich (landen im Browser-Bundle);
# geschützt wird über firestore.rules und storage.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=huerrem-menu-app-1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=huerrem-menu-app-1
VITE_FIREBASE_STORAGE_BUCKET=huerrem-menu-app-1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
